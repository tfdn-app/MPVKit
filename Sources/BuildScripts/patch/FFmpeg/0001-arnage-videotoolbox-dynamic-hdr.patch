+/*
+ * Dolby Vision (profiles 5 and 8), opt-in through the HEVC decoder option
+ * "videotoolbox_dovi".
+ *
+ * Opened as plain HEVC, the decoder ignores the RPU. Opened as Dolby Vision
+ * ('dvh1', with the stream's configuration record next to hvcC) and given the
+ * RPU NAL unit of each access unit, it hands the RPU on with the decoded
+ * picture, for the display stage to compose.
+ */
+enum { VT_CODEC_TYPE_DOLBY_VISION_HEVC = 'dvh1' };
+
+static int videotoolbox_hevc_dovi_wanted(AVCodecContext *avctx)
+{
+    const HEVCContext *h;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+    h = avctx->priv_data;
+    if (!h->videotoolbox_dovi)
+        return 0;
+    if (h->dovi_ctx.cfg.dv_profile == 5)
+        return 1;
+    /* Profile 8 only with a defined cross-compatible base layer (1 = HDR10,
+     * 2 = SDR, 4 = HLG): the decoder refuses a session for any other id. */
+    return h->dovi_ctx.cfg.dv_profile == 8 &&
+           (h->dovi_ctx.cfg.dv_bl_signal_compatibility_id == 1 ||
+            h->dovi_ctx.cfg.dv_bl_signal_compatibility_id == 2 ||
+            h->dovi_ctx.cfg.dv_bl_signal_compatibility_id == 4);
+}
+
+/*
+ * HDR10+, opt-in through the HEVC decoder option "videotoolbox_hdr10plus".
+ *
+ * The decoder hands the HDR10+ per-frame data of the bitstream on with the
+ * decoded picture only if the session's format description declares the PQ
+ * transfer function. (The SEI NAL units themselves are already submitted.)
+ */
+static int videotoolbox_hevc_pq_wanted(AVCodecContext *avctx)
+{
+    const HEVCContext *h;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+    h = avctx->priv_data;
+    return h->videotoolbox_hdr10plus && avctx->color_trc == AVCOL_TRC_SMPTE2084;
+}
+
+/* The 24-byte DOVIDecoderConfigurationRecord of the stream. */
+static CFDataRef videotoolbox_dovi_record_create(AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    const AVDOVIDecoderConfigurationRecord *cfg = &h->dovi_ctx.cfg;
+    uint8_t record[24] = { 0 };
+    unsigned packed = (cfg->dv_profile & 0x7F) << 9 |
+                      (cfg->dv_level   & 0x3F) << 3 |
+                      (cfg->rpu_present_flag & 1) << 2 |
+                      (cfg->el_present_flag  & 1) << 1 |
+                      (cfg->bl_present_flag  & 1);
+
+    record[0] = cfg->dv_version_major;
+    record[1] = cfg->dv_version_minor;
+    record[2] = packed >> 8;
+    record[3] = packed & 0xFF;
+    record[4] = (cfg->dv_bl_signal_compatibility_id & 0x0F) << 4 |
+                (cfg->dv_md_compression & 0x03) << 2;
+
+    return CFDataCreate(kCFAllocatorDefault, record, sizeof(record));
+}
+
 static void videotoolbox_decoder_callback(void *opaque,
                                           void *sourceFrameRefCon,
                                           OSStatus status,
