+        CFTypeRef data = CVBufferGetAttachment(image_buffer, CFSTR("HDR10PlusData"), NULL);
+        if (data || ++vtctx->hdr10plus_checked >= 48) {
+            av_log(vtctx->logctx, AV_LOG_INFO, "VideoToolbox: declared PQ; %s\n",
+                   data ? "decoded pictures carry HDR10+ data"
+                        : "no HDR10+ data in the first 48 decoded pictures");
+            vtctx->hdr10plus_reported = true;
+        }
+    }
+
     vtctx->frame = CVPixelBufferRetain(image_buffer);
 }
 
