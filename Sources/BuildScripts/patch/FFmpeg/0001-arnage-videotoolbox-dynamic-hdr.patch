+        av_log(vtctx->logctx, AV_LOG_INFO,
+               "VideoToolbox: declared PQ; first decoded picture %s HDR10+ data\n",
+               data ? "carries" : "carries no");
+        vtctx->hdr10plus_reported = true;
+    }
+
     vtctx->frame = CVPixelBufferRetain(image_buffer);
 }
 
