@@ -1126,6 +1259,26 @@
     VTContext *vtctx = avctx->internal->hwaccel_priv_data;
     int ret;
 
+    if (videotoolbox_hevc_dovi_wanted(avctx)) {
+        /* The RPU of this access unit was set aside by the HEVC decoder,
+         * without its two NAL header bytes. Submit it as the last NAL unit:
+         * type 62, layer 0, temporal id 1. */
+        const AVFrameSideData *rpu =
+            av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+        if (rpu && rpu->size > 0 && vtctx->bitstream_size > 0) {
+            void *tmp = av_fast_realloc(vtctx->bitstream, &vtctx->allocated_size,
+                                        vtctx->bitstream_size + rpu->size + 6);
+            if (!tmp)
+                return AVERROR(ENOMEM);
+            vtctx->bitstream = tmp;
+            AV_WB32(vtctx->bitstream + vtctx->bitstream_size, rpu->size + 2);
+            vtctx->bitstream[vtctx->bitstream_size + 4] = 0x7C;
+            vtctx->bitstream[vtctx->bitstream_size + 5] = 0x01;
+            memcpy(vtctx->bitstream + vtctx->bitstream_size + 6, rpu->data, rpu->size);
+            vtctx->bitstream_size += rpu->size + 6;
+        }
+    }
+
     ret = ff_videotoolbox_common_end_frame(avctx, frame);
     vtctx->bitstream_size = 0;
     return ret;
