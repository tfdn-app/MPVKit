@@ -421,6 +421,18 @@ if features['cocoa']
     main_fn_source = files('osdep/main-fn-mac.c')
 endif
 
+# vo=avfoundation: present VideoToolbox frames on an AVSampleBufferDisplayLayer
+# (arnage #476). darwin-only; named avfoundation-vo to avoid the avfoundation
+# (audio output) option.
+avfoundation_vo = get_option('avfoundation-vo').require(darwin,
+    error_message: 'the avfoundation video output is only available on darwin')
+features += {'avfoundation-vo': avfoundation_vo.allowed()}
+if features['avfoundation-vo']
+    dependencies += dependency('appleframeworks',
+                               modules: ['AVFoundation', 'CoreMedia', 'CoreVideo', 'QuartzCore'])
+    sources += files('video/out/vo_avfoundation.m')
+endif
+
 if posix
     if not get_option('fuzzers') and cc.has_function('fork', prefix : '#include <unistd.h>')
         sources += files('osdep/subprocess-posix.c')
