diff --git a/video/out/vo_avfoundation.m b/video/out/vo_avfoundation.m
new file mode 100644
index 0000000..72ee647
--- /dev/null
+++ b/video/out/vo_avfoundation.m
@@ -0,0 +1,984 @@
+/*
+ * vo_avfoundation: present VideoToolbox-decoded frames on an
+ * AVSampleBufferDisplayLayer that the embedder owns (passed via --wid).
+ *
+ * Clean-room implementation (arnage #476, #481). Authored from the public mpv
+ * VO API (video/out/vo.h, video/mp_image.h, sub/osd.h), mpv's own VideoToolbox
+ * frame handling (video/out/hwdec/hwdec_ios_gl.m: CVPixelBufferRef == planes[3]),
+ * mpv's OSD-on-image blender (sub/osd.h: osd_draw_on_image), and Apple's
+ * AVFoundation / CoreMedia / CoreVideo documentation. No code from any
+ * third-party vo=avfoundation implementation was consulted.
+ *
+ * The inline OSD layer (#481) composites subtitles/OSD onto a second,
+ * embedder-owned AVSampleBufferDisplayLayer (avfoundation-osd-wid) stacked
+ * above the video layer. mpv's blender handles libass text and BGRA image
+ * subs; the embedder keeps both layers' videoGravity in sync.
+ *
+ * This file is licensed under LGPLv2.1+ (it is linked into mpv).
+ *
+ * mpv is compiled without ARC: ObjC/CF memory is managed manually.
+ */
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreImage/CoreImage.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+#import <TargetConditionals.h>
+
+#include <assert.h>
+
+#include <libavutil/hwcontext.h>
+
+#include "mpv_talloc.h"
+#include "common/common.h"
+#include "common/msg.h"
+#include "options/m_option.h"
+#include "options/options.h"
+#include "sub/osd.h"
+#include "video/hwdec.h"
+#include "video/mp_image.h"
+#include "video/out/vo.h"
+
+struct priv {
+    AVSampleBufferDisplayLayer *layer;   // borrowed; owned by the embedder via --wid
+    CMVideoFormatDescriptionRef fmt;     // rebuilt when the pixel buffer format changes
+    struct mp_hwdec_ctx hwctx;           // VideoToolbox device we register for the decoder
+    bool hwdec_registered;
+    bool created_hwdec_devs;             // we own vo->hwdec_devs and must destroy it
+    CVPixelBufferPoolRef pool;           // software-path buffer pool (keyed on w/h/fmt)
+    int pool_w, pool_h;
+    OSType pool_fmt;
+
+    // Inline OSD layer (arnage #481): a second embedder-owned layer the VO
+    // composites subtitles/OSD into. Borrowed via avfoundation-osd-wid.
+    AVSampleBufferDisplayLayer *osd_layer; // borrowed; owned by the embedder
+    int64_t osd_wid;                       // option: OSD layer pointer
+    bool composite_osd;                    // option: enable OSD compositing
+    CVPixelBufferPoolRef osd_pool;         // OSD BGRA canvas pool (keyed on w/h)
+    int osd_pool_w, osd_pool_h;
+    int64_t osd_change_id;                 // last composited OSD change id
+
+    // OSD burn-in (arnage #480, PiP): while in PiP the OS shows only the single
+    // video layer, so the OSD must be composited INTO the video frame instead of
+    // the separate osd_layer. GPU composite (CoreImage) of the cached OSD BGRA
+    // canvas over each video frame; the cached canvas is re-rendered only when
+    // the OSD change id moves. Isolated from the inline-OSD path above — when
+    // burn-in is off the VO behaves exactly as #481.
+    //
+    // Toggled at runtime by the embedder via a KVC flag on the video layer
+    // (layer.setValue(bool, forKey:"arnageOsdBurnIn")) — NOT an mpv option: a
+    // VO driver's private options are a snapshot of the config taken at VO
+    // creation (m_config_group_from_desc), so mpv_set_property on them does not
+    // reach vo->priv live. The layer is embedder-owned and read each frame.
+    CVPixelBufferRef burn_osd_buf;         // cached OSD BGRA canvas (retained, +1)
+    int64_t burn_osd_change_id;            // change id of the cached OSD canvas
+    int burn_osd_items;                    // num_items of the cached OSD canvas
+    bool burn_osd_flushed;                 // separate osd_layer flushed once for PiP
+    CIContext *ci_ctx;                     // CoreImage context for the composite
+    CVPixelBufferPoolRef burn_pool;        // composited-output pool (video fmt)
+    int burn_pool_w, burn_pool_h;
+    OSType burn_pool_fmt;
+};
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    int64_t wid = vo->opts->WinID;
+    if (wid <= 0) {
+        MP_FATAL(vo, "vo=avfoundation requires --wid set to an "
+                     "AVSampleBufferDisplayLayer pointer.\n");
+        return -1;
+    }
+
+    id obj = (id)(intptr_t)wid;
+    if (![obj isKindOfClass:[AVSampleBufferDisplayLayer class]]) {
+        MP_FATAL(vo, "--wid does not point at an AVSampleBufferDisplayLayer.\n");
+        return -1;
+    }
+
+    p->layer = (AVSampleBufferDisplayLayer *)obj;
+    AVSampleBufferDisplayLayer *layer = p->layer;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        layer.videoGravity = AVLayerVideoGravityResizeAspect;
+        // wantsExtendedDynamicRangeContent is an iOS/macOS/Catalyst API, not
+        // tvOS (where the system drives HDR natively) -- referencing it in a
+        // tvOS build is a compile error, so guard it out there.
+#if !TARGET_OS_TV
+        if (@available(iOS 17.0, macCatalyst 17.0, macOS 13.0, *))
+            layer.wantsExtendedDynamicRangeContent = YES;
+#endif
+    });
+
+    // Register a VideoToolbox hwdec device ourselves. Unlike the gpu VOs, this
+    // VO has no `ra` context, so mpv's ra_hwdec_videotoolbox never loads and the
+    // decoder would fall back to software. We accept software frames too (see
+    // query_format / sw_image_to_pixel_buffer), but registering the device lets
+    // VideoToolbox-decodable codecs deliver zero-copy IMGFMT_VIDEOTOOLBOX
+    // (CVPixelBuffer) frames straight to draw_frame.
+    // A standalone VO starts with no hwdec registry (only the gpu VOs create
+    // one); create it so we can publish our device.
+    if (!vo->hwdec_devs) {
+        vo->hwdec_devs = hwdec_devices_create();
+        p->created_hwdec_devs = true;
+    }
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "avfoundation",
+        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+    };
+    int ret = av_hwdevice_ctx_create(&p->hwctx.av_device_ref,
+                                     AV_HWDEVICE_TYPE_VIDEOTOOLBOX, NULL, NULL, 0);
+    if (ret == 0) {
+        hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+        p->hwdec_registered = true;
+    } else {
+        MP_WARN(vo, "could not create VideoToolbox hwdevice: %s\n", av_err2str(ret));
+    }
+
+    // Optional inline OSD layer (#481): a second embedder-owned
+    // AVSampleBufferDisplayLayer passed via avfoundation-osd-wid. Non-fatal —
+    // if absent or wrong-typed, OSD compositing stays disabled and video still
+    // plays. The embedder owns this layer and keeps its videoGravity in sync
+    // with the video layer, so the VO never touches its geometry.
+    if (p->composite_osd && p->osd_wid > 0) {
+        id osd_obj = (id)(intptr_t)p->osd_wid;
+        if ([osd_obj isKindOfClass:[AVSampleBufferDisplayLayer class]]) {
+            p->osd_layer = (AVSampleBufferDisplayLayer *)osd_obj;
+            MP_VERBOSE(vo, "inline OSD layer %p attached\n", (void *)p->osd_layer);
+        } else {
+            MP_WARN(vo, "avfoundation-osd-wid is not an "
+                        "AVSampleBufferDisplayLayer; OSD compositing disabled.\n");
+        }
+    }
+
+    MP_VERBOSE(vo, "attached to AVSampleBufferDisplayLayer %p\n", (void *)p->layer);
+    return 0;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    // Zero-copy hardware frames from mpv's videotoolbox hwdec, plus the two
+    // software biplanar formats we can upload into a CVPixelBuffer. Advertising
+    // the software formats makes mpv's autoconvert filter deliver every
+    // software-decoded frame (codecs VideoToolbox can't decode: AV1 on pre-A17,
+    // VP8/VP9, exotic) as NV12 (8-bit) or P010 (10-bit, HDR-capable), so no
+    // codec is lost. Hardware decode stays preferred (hwdec=videotoolbox); the
+    // software path is the fallback.
+    return format == IMGFMT_VIDEOTOOLBOX
+        || format == IMGFMT_NV12
+        || format == IMGFMT_P010;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    struct priv *p = vo->priv;
+    // Drop the cached format description; the next frame rebuilds it from the
+    // incoming pixel buffer (which carries the up-to-date colorimetry).
+    if (p->fmt) {
+        CFRelease(p->fmt);
+        p->fmt = NULL;
+    }
+    // Drop the software-path pool; the next software frame rebuilds it for the
+    // new geometry/format.
+    if (p->pool) {
+        CVPixelBufferPoolRelease(p->pool);
+        p->pool = NULL;
+    }
+    p->pool_w = p->pool_h = 0;
+    p->pool_fmt = 0;
+    // Drop the OSD canvas pool; the next OSD frame rebuilds it for the new
+    // geometry, and force a re-composite by resetting the change id.
+    if (p->osd_pool) {
+        CVPixelBufferPoolRelease(p->osd_pool);
+        p->osd_pool = NULL;
+    }
+    p->osd_pool_w = p->osd_pool_h = 0;
+    p->osd_change_id = 0;
+    // Drop the burn-in cached canvas + output pool; the next frame rebuilds them.
+    if (p->burn_osd_buf) {
+        CVPixelBufferRelease(p->burn_osd_buf);
+        p->burn_osd_buf = NULL;
+    }
+    p->burn_osd_change_id = 0;
+    p->burn_osd_items = 0;
+    p->burn_osd_flushed = false;
+    if (p->burn_pool) {
+        CVPixelBufferPoolRelease(p->burn_pool);
+        p->burn_pool = NULL;
+    }
+    p->burn_pool_w = p->burn_pool_h = 0;
+    p->burn_pool_fmt = 0;
+    return 0;
+}
+
+// MARK: - software frame -> CVPixelBuffer
+
+static CFStringRef cv_primaries(enum pl_color_primaries prim)
+{
+    switch (prim) {
+    case PL_COLOR_PRIM_BT_2020:     return kCVImageBufferColorPrimaries_ITU_R_2020;
+    case PL_COLOR_PRIM_BT_601_525:  return kCVImageBufferColorPrimaries_SMPTE_C;
+    case PL_COLOR_PRIM_BT_601_625:  return kCVImageBufferColorPrimaries_EBU_3213;
+    case PL_COLOR_PRIM_BT_709:
+    default:                        return kCVImageBufferColorPrimaries_ITU_R_709_2;
+    }
+}
+
+static CFStringRef cv_transfer(enum pl_color_transfer trc)
+{
+    switch (trc) {
+    case PL_COLOR_TRC_PQ:   return kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ;
+    case PL_COLOR_TRC_HLG:  return kCVImageBufferTransferFunction_ITU_R_2100_HLG;
+    case PL_COLOR_TRC_BT_1886:
+    case PL_COLOR_TRC_SRGB:
+    default:                return kCVImageBufferTransferFunction_ITU_R_709_2;
+    }
+}
+
+static CFStringRef cv_matrix(enum pl_color_system sys)
+{
+    switch (sys) {
+    case PL_COLOR_SYSTEM_BT_2020_NC:
+    case PL_COLOR_SYSTEM_BT_2020_C: return kCVImageBufferYCbCrMatrix_ITU_R_2020;
+    case PL_COLOR_SYSTEM_BT_601:    return kCVImageBufferYCbCrMatrix_ITU_R_601_4;
+    case PL_COLOR_SYSTEM_BT_709:
+    default:                        return kCVImageBufferYCbCrMatrix_ITU_R_709_2;
+    }
+}
+
+// Uploads a software-decoded biplanar mp_image (NV12 or P010) into a fresh
+// CVPixelBuffer, copying both planes and stamping the colorimetry so the
+// CMVideoFormatDescription built from it presents correct colors (and EDR for
+// PQ/HLG). Returns a +1 buffer the caller releases, or NULL on failure.
+static CVPixelBufferRef sw_image_to_pixel_buffer(struct vo *vo, struct mp_image *mpi)
+{
+    struct priv *p = vo->priv;
+    bool full = mpi->params.repr.levels == PL_COLOR_LEVELS_FULL;
+    OSType cvfmt;
+    switch (mpi->imgfmt) {
+    case IMGFMT_NV12:
+        cvfmt = full ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+                     : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+        break;
+    case IMGFMT_P010:
+        cvfmt = full ? kCVPixelFormatType_420YpCbCr10BiPlanarFullRange
+                     : kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+        break;
+    default:
+        return NULL;
+    }
+
+    // Pool the pixel buffers: allocating a CVPixelBuffer (+ its IOSurface) per
+    // frame is wasteful on the software-decode path. Rebuild the pool only when
+    // the geometry/format changes, reusing it across frames otherwise; reconfig
+    // and uninit release it.
+    if (!p->pool || p->pool_w != mpi->w || p->pool_h != mpi->h || p->pool_fmt != cvfmt) {
+        if (p->pool) {
+            CVPixelBufferPoolRelease(p->pool);
+            p->pool = NULL;
+        }
+        // The pool's pixelBufferAttributes describe the buffers it vends:
+        // IOSurface-backed (so the layer can present them), with this clip's
+        // format and geometry.
+        CFDictionaryRef empty = CFDictionaryCreate(
+            NULL, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        int fmt = (int)cvfmt;
+        CFNumberRef wn = CFNumberCreate(NULL, kCFNumberIntType, &mpi->w);
+        CFNumberRef hn = CFNumberCreate(NULL, kCFNumberIntType, &mpi->h);
+        CFNumberRef fn = CFNumberCreate(NULL, kCFNumberIntType, &fmt);
+        const void *keys[4] = {
+            kCVPixelBufferIOSurfacePropertiesKey,
+            kCVPixelBufferPixelFormatTypeKey,
+            kCVPixelBufferWidthKey,
+            kCVPixelBufferHeightKey,
+        };
+        const void *vals[4] = { empty, fn, wn, hn };
+        CFDictionaryRef attrs = CFDictionaryCreate(
+            NULL, keys, vals, 4,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn pr = CVPixelBufferPoolCreate(NULL, NULL, attrs, &p->pool);
+        CFRelease(attrs);
+        CFRelease(empty);
+        CFRelease(wn);
+        CFRelease(hn);
+        CFRelease(fn);
+        if (pr != kCVReturnSuccess || !p->pool) {
+            MP_ERR(vo, "CVPixelBufferPoolCreate failed: %d\n", (int)pr);
+            p->pool = NULL;
+            return NULL;
+        }
+        p->pool_w = mpi->w;
+        p->pool_h = mpi->h;
+        p->pool_fmt = cvfmt;
+    }
+
+    CVPixelBufferRef pb = NULL;
+    CVReturn r = CVPixelBufferPoolCreatePixelBuffer(NULL, p->pool, &pb);
+    if (r != kCVReturnSuccess || !pb) {
+        MP_ERR(vo, "CVPixelBufferPoolCreatePixelBuffer failed: %d\n", (int)r);
+        return NULL;
+    }
+
+    CVPixelBufferLockBaseAddress(pb, 0);
+    size_t nplanes = CVPixelBufferGetPlaneCount(pb);   // 2 (Y, interleaved UV)
+    for (size_t pl = 0; pl < nplanes && pl < MP_MAX_PLANES; pl++) {
+        uint8_t *dst = CVPixelBufferGetBaseAddressOfPlane(pb, pl);
+        size_t dst_stride = CVPixelBufferGetBytesPerRowOfPlane(pb, pl);
+        size_t plane_h = CVPixelBufferGetHeightOfPlane(pb, pl);
+        uint8_t *src = mpi->planes[pl];
+        ptrdiff_t src_stride = mpi->stride[pl];
+        if (!dst || !src)
+            continue;
+        // A valid plane has a non-zero stride; negative (bottom-up) strides are
+        // handled by the signed pointer arithmetic below.
+        assert(src_stride != 0);
+        // Copy only the active row bytes; the smaller stride bounds both sides
+        // so neither padding region is over-read or over-written.
+        size_t abs_src = src_stride < 0 ? (size_t)(-src_stride) : (size_t)src_stride;
+        size_t row = dst_stride < abs_src ? dst_stride : abs_src;
+        for (size_t y = 0; y < plane_h; y++)
+            memcpy(dst + y * dst_stride, src + (ptrdiff_t)y * src_stride, row);
+    }
+    CVPixelBufferUnlockBaseAddress(pb, 0);
+
+    CVBufferSetAttachment(pb, kCVImageBufferColorPrimariesKey,
+                          cv_primaries(mpi->params.color.primaries),
+                          kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(pb, kCVImageBufferTransferFunctionKey,
+                          cv_transfer(mpi->params.color.transfer),
+                          kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(pb, kCVImageBufferYCbCrMatrixKey,
+                          cv_matrix(mpi->params.repr.sys),
+                          kCVAttachmentMode_ShouldPropagate);
+    return pb;
+}
+
+// MARK: - inline OSD layer (subtitles / OSD, arnage #481)
+
+// Composite the current subtitles onto the separate transparent OSD layer.
+// mpv's own blender (osd_draw_on_image) handles libass A8+color text and
+// premultiplied BGRA image subs (PGS/VobSub), including scaling, so we only
+// supply a BGRA canvas matching the video frame and present it on the OSD
+// layer. The embedder keeps the OSD layer's videoGravity in sync with the
+// video layer, so the OSD letterboxes/crops identically to the image.
+//
+// OSD_DRAW_SUB_ONLY draws subtitles only (not mpv's own OSD bar/messages — the
+// app drives its own chrome). Gated on the OSD change id: osd_render is
+// internally cached by change id, so an unchanged frame skips the costly
+// CVPixelBuffer composite + enqueue. An empty OSD flushes the layer once.
+static void draw_osd_overlay(struct vo *vo, struct mp_image *mpi)
+{
+    struct priv *p = vo->priv;
+    if (!p->composite_osd || !p->osd_layer || !vo->osd)
+        return;
+
+    static const bool osd_formats[SUBBITMAP_COUNT] = {
+        [SUBBITMAP_LIBASS] = true,
+        [SUBBITMAP_BGRA]   = true,
+    };
+    struct mp_osd_res res = osd_res_from_image_params(&mpi->params);
+
+    // Cheap change check before the expensive composite/enqueue. mpv caches the
+    // rendered bitmaps by change id, so this and the osd_draw_on_image below do
+    // not double the rendering cost. (Possible micro-optimisation: composite
+    // directly from this list instead of calling osd_draw_on_image.)
+    struct sub_bitmap_list *list =
+        osd_render(vo->osd, res, mpi->pts, OSD_DRAW_SUB_ONLY, osd_formats);
+    int64_t change_id = list ? list->change_id : 0;
+    int num_items = list ? list->num_items : 0;
+    talloc_free(list);
+    if (change_id == p->osd_change_id)
+        return;                 // OSD unchanged since the last enqueue
+    // Commit the change id only on the success paths below — a transient
+    // allocation failure must not advance it, or the same OSD content would be
+    // gated out on the next frame and the cue silently dropped.
+
+    AVSampleBufferDisplayLayer *osd_layer = p->osd_layer;
+    if (num_items == 0) {       // OSD cleared
+        p->osd_change_id = change_id;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [osd_layer flushAndRemoveImage];
+        });
+        return;
+    }
+
+    int w = mpi->w, h = mpi->h;
+    if (w <= 0 || h <= 0)
+        return;
+
+    // BGRA canvas pool, rebuilt on geometry change (mirrors the software pool).
+    if (!p->osd_pool || p->osd_pool_w != w || p->osd_pool_h != h) {
+        if (p->osd_pool) {
+            CVPixelBufferPoolRelease(p->osd_pool);
+            p->osd_pool = NULL;
+        }
+        CFDictionaryRef empty = CFDictionaryCreate(
+            NULL, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        int fmt = kCVPixelFormatType_32BGRA;
+        CFNumberRef wn = CFNumberCreate(NULL, kCFNumberIntType, &w);
+        CFNumberRef hn = CFNumberCreate(NULL, kCFNumberIntType, &h);
+        CFNumberRef fn = CFNumberCreate(NULL, kCFNumberIntType, &fmt);
+        const void *keys[4] = {
+            kCVPixelBufferIOSurfacePropertiesKey,
+            kCVPixelBufferPixelFormatTypeKey,
+            kCVPixelBufferWidthKey,
+            kCVPixelBufferHeightKey,
+        };
+        const void *vals[4] = { empty, fn, wn, hn };
+        CFDictionaryRef attrs = CFDictionaryCreate(
+            NULL, keys, vals, 4,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn pr = CVPixelBufferPoolCreate(NULL, NULL, attrs, &p->osd_pool);
+        CFRelease(attrs);
+        CFRelease(empty);
+        CFRelease(wn);
+        CFRelease(hn);
+        CFRelease(fn);
+        if (pr != kCVReturnSuccess || !p->osd_pool) {
+            MP_ERR(vo, "OSD CVPixelBufferPoolCreate failed: %d\n", (int)pr);
+            p->osd_pool = NULL;
+            return;
+        }
+        p->osd_pool_w = w;
+        p->osd_pool_h = h;
+    }
+
+    CVPixelBufferRef pb = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(NULL, p->osd_pool, &pb) != kCVReturnSuccess
+        || !pb)
+        return;
+
+    CVPixelBufferLockBaseAddress(pb, 0);
+    uint8_t *base = CVPixelBufferGetBaseAddress(pb);
+    size_t bstride = CVPixelBufferGetBytesPerRow(pb);
+    // Transparent canvas: the OSD blends OVER, so start fully clear.
+    for (int y = 0; y < h; y++)
+        memset(base + (size_t)y * bstride, 0, (size_t)w * 4);
+
+    // Wrap the locked BGRA buffer as an mp_image and let mpv composite the OSD.
+    struct mp_image dst = {0};
+    mp_image_setfmt(&dst, IMGFMT_BGRA);
+    mp_image_set_size(&dst, w, h);
+    dst.planes[0] = base;
+    dst.stride[0] = (int)bstride;
+    // Standard SDR sRGB RGB target; the OSD layer presents it as plain SDR.
+    // Declare premultiplied alpha: AVSampleBufferDisplayLayer/CoreAnimation
+    // composite assuming premultiplied BGRA, and it lets mpv's blender write
+    // straight into the canvas (no unpremul round-trip that would otherwise
+    // emit non-premultiplied alpha and fringe the antialiased text edges).
+    dst.params.color.primaries = PL_COLOR_PRIM_BT_709;
+    dst.params.color.transfer  = PL_COLOR_TRC_SRGB;
+    dst.params.repr.levels     = PL_COLOR_LEVELS_FULL;
+    dst.params.repr.alpha      = PL_ALPHA_PREMULTIPLIED;
+
+    osd_draw_on_image(vo->osd, res, mpi->pts, OSD_DRAW_SUB_ONLY, &dst);
+    CVPixelBufferUnlockBaseAddress(pb, 0);
+
+    CMVideoFormatDescriptionRef fmtdesc = NULL;
+    if (CMVideoFormatDescriptionCreateForImageBuffer(
+            kCFAllocatorDefault, pb, &fmtdesc) != noErr || !fmtdesc) {
+        CVPixelBufferRelease(pb);
+        return;
+    }
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+    CMSampleBufferRef sbuf = NULL;
+    OSStatus st = CMSampleBufferCreateReadyWithImageBuffer(
+        kCFAllocatorDefault, pb, fmtdesc, &timing, &sbuf);
+    CFRelease(fmtdesc);
+    CVPixelBufferRelease(pb);
+    if (st != noErr || !sbuf)
+        return;
+
+    CFArrayRef att = CMSampleBufferGetSampleAttachmentsArray(sbuf, true);
+    if (att && CFArrayGetCount(att) > 0) {
+        CFMutableDictionaryRef d =
+            (CFMutableDictionaryRef)CFArrayGetValueAtIndex(att, 0);
+        CFDictionarySetValue(d, kCMSampleAttachmentKey_DisplayImmediately,
+                             kCFBooleanTrue);
+    }
+    // All fallible allocations succeeded: commit the change id, then enqueue.
+    p->osd_change_id = change_id;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (osd_layer.status == AVQueuedSampleBufferRenderingStatusFailed)
+            [osd_layer flush];
+        [osd_layer enqueueSampleBuffer:sbuf];
+        CFRelease(sbuf);
+    });
+}
+
+// MARK: - OSD burn-in for PiP (arnage #480)
+
+// Render the current subtitles/OSD into a fresh BGRA CVPixelBuffer sized to the
+// video frame. Unlike draw_osd_overlay this does NOT gate on the change id —
+// burn_composite caches the result and reuses it across unchanged frames.
+// Reuses osd_pool (idle while burning in, since the separate osd_layer is not
+// presented). Returns a +1 buffer the caller releases, or NULL (no OSD / fail).
+static CVPixelBufferRef render_burn_osd_canvas(struct vo *vo, struct mp_image *mpi,
+                                               int num_items)
+{
+    struct priv *p = vo->priv;
+    if (num_items == 0 || !vo->osd)
+        return NULL;
+
+    int w = mpi->w, h = mpi->h;
+    if (w <= 0 || h <= 0)
+        return NULL;
+
+    if (!p->osd_pool || p->osd_pool_w != w || p->osd_pool_h != h) {
+        if (p->osd_pool) {
+            CVPixelBufferPoolRelease(p->osd_pool);
+            p->osd_pool = NULL;
+        }
+        CFDictionaryRef empty = CFDictionaryCreate(
+            NULL, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        int fmt = kCVPixelFormatType_32BGRA;
+        CFNumberRef wn = CFNumberCreate(NULL, kCFNumberIntType, &w);
+        CFNumberRef hn = CFNumberCreate(NULL, kCFNumberIntType, &h);
+        CFNumberRef fn = CFNumberCreate(NULL, kCFNumberIntType, &fmt);
+        const void *keys[4] = {
+            kCVPixelBufferIOSurfacePropertiesKey,
+            kCVPixelBufferPixelFormatTypeKey,
+            kCVPixelBufferWidthKey,
+            kCVPixelBufferHeightKey,
+        };
+        const void *vals[4] = { empty, fn, wn, hn };
+        CFDictionaryRef attrs = CFDictionaryCreate(
+            NULL, keys, vals, 4,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn pr = CVPixelBufferPoolCreate(NULL, NULL, attrs, &p->osd_pool);
+        CFRelease(attrs);
+        CFRelease(empty);
+        CFRelease(wn);
+        CFRelease(hn);
+        CFRelease(fn);
+        if (pr != kCVReturnSuccess || !p->osd_pool) {
+            MP_ERR(vo, "burn-in OSD pool create failed: %d\n", (int)pr);
+            p->osd_pool = NULL;
+            return NULL;
+        }
+        p->osd_pool_w = w;
+        p->osd_pool_h = h;
+    }
+
+    CVPixelBufferRef pb = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(NULL, p->osd_pool, &pb) != kCVReturnSuccess
+        || !pb)
+        return NULL;
+
+    CVPixelBufferLockBaseAddress(pb, 0);
+    uint8_t *base = CVPixelBufferGetBaseAddress(pb);
+    size_t bstride = CVPixelBufferGetBytesPerRow(pb);
+    for (int y = 0; y < h; y++)
+        memset(base + (size_t)y * bstride, 0, (size_t)w * 4);
+
+    struct mp_osd_res res = osd_res_from_image_params(&mpi->params);
+    struct mp_image dst = {0};
+    mp_image_setfmt(&dst, IMGFMT_BGRA);
+    mp_image_set_size(&dst, w, h);
+    dst.planes[0] = base;
+    dst.stride[0] = (int)bstride;
+    dst.params.color.primaries = PL_COLOR_PRIM_BT_709;
+    dst.params.color.transfer  = PL_COLOR_TRC_SRGB;
+    dst.params.repr.levels     = PL_COLOR_LEVELS_FULL;
+    dst.params.repr.alpha      = PL_ALPHA_PREMULTIPLIED;
+
+    osd_draw_on_image(vo->osd, res, mpi->pts, OSD_DRAW_SUB_ONLY, &dst);
+    CVPixelBufferUnlockBaseAddress(pb, 0);
+    return pb;
+}
+
+// SDR OSD text/graphics must land at SDR reference white in the output, not at
+// PQ/HLG peak — so the composite is colour-managed to the video's transfer.
+static CGColorSpaceRef burn_output_colorspace(enum pl_color_transfer trc)
+{
+    if (trc == PL_COLOR_TRC_PQ)
+        return CGColorSpaceCreateWithName(kCGColorSpaceITUR_2020_PQ);
+    if (trc == PL_COLOR_TRC_HLG)
+        return CGColorSpaceCreateWithName(kCGColorSpaceITUR_2020_HLG);
+    return CGColorSpaceCreateWithName(kCGColorSpaceITUR_709);
+}
+
+static void ensure_ci_ctx(struct priv *p)
+{
+    if (p->ci_ctx)
+        return;
+    // HDR-capable working space: extended-linear BT.2020 with half-float
+    // precision keeps > 1.0 highlights so PQ/HLG video is not clipped by the
+    // SDR OSD overlay.
+    @autoreleasepool {
+        CGColorSpaceRef work =
+            CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearITUR_2020);
+        NSDictionary *opts = @{
+            kCIContextWorkingColorSpace: (id)work,
+            kCIContextWorkingFormat: @(kCIFormatRGBAh),
+        };
+        p->ci_ctx = [[CIContext contextWithOptions:opts] retain];
+        if (work)
+            CGColorSpaceRelease(work);
+    }
+}
+
+// Runtime burn-in switch, read from the embedder-owned video layer each frame.
+// Swift sets `layer.setValue(NSNumber(value: on), forKey: "arnageOsdBurnIn")`.
+// CALayer supports arbitrary KVC keys (returns nil when unset -> off). Boolean
+// NSNumbers are the immortal __NSCFBoolean singletons and pointer reads are
+// atomic on arm64, so the main-thread write / render-thread read needs no lock.
+static bool burn_in_active(struct priv *p)
+{
+    if (!p->layer)
+        return false;
+    NSNumber *v = [p->layer valueForKey:@"arnageOsdBurnIn"];
+    return v != nil && [v boolValue];
+}
+
+// Composite the cached OSD canvas over the video frame on the GPU (CoreImage),
+// returning a new video-format CVPixelBuffer that carries the source colorimetry
+// (so the OS still drives EDR). Returns a +1 buffer, or NULL when there is no
+// OSD to burn (caller enqueues the plain frame) or on failure.
+static CVPixelBufferRef burn_composite(struct vo *vo, struct mp_image *mpi,
+                                       CVPixelBufferRef video)
+{
+    struct priv *p = vo->priv;
+
+    // Cheap change probe (osd_render is cached by mpv); re-render the canvas only
+    // when the OSD moves, reuse the cached buffer otherwise.
+    static const bool osd_formats[SUBBITMAP_COUNT] = {
+        [SUBBITMAP_LIBASS] = true,
+        [SUBBITMAP_BGRA]   = true,
+    };
+    struct mp_osd_res res = osd_res_from_image_params(&mpi->params);
+    struct sub_bitmap_list *list =
+        osd_render(vo->osd, res, mpi->pts, OSD_DRAW_SUB_ONLY, osd_formats);
+    int64_t change_id = list ? list->change_id : 0;
+    int num_items = list ? list->num_items : 0;
+    talloc_free(list);
+
+    if (change_id != p->burn_osd_change_id) {
+        if (p->burn_osd_buf) {
+            CVPixelBufferRelease(p->burn_osd_buf);
+            p->burn_osd_buf = NULL;
+        }
+        CVPixelBufferRef fresh = render_burn_osd_canvas(vo, mpi, num_items);
+        // Only commit the change id on success (or a legitimate empty OSD). A
+        // transient canvas-alloc failure with num_items>0 must NOT advance the
+        // id, or the same cue would be gated out for the rest of its life and
+        // silently dropped (mirrors the #481 draw_osd_overlay invariant). Leave
+        // the id stale so the next frame retries; we enqueue the plain frame
+        // this once.
+        if (fresh || num_items == 0) {
+            p->burn_osd_buf = fresh;
+            p->burn_osd_items = fresh ? num_items : 0;
+            p->burn_osd_change_id = change_id;
+        }
+    }
+    if (!p->burn_osd_buf || p->burn_osd_items == 0)
+        return NULL;   // nothing to burn — caller enqueues the plain frame
+
+    OSType vfmt = CVPixelBufferGetPixelFormatType(video);
+    int w = (int)CVPixelBufferGetWidth(video);
+    int h = (int)CVPixelBufferGetHeight(video);
+
+    if (!p->burn_pool || p->burn_pool_w != w || p->burn_pool_h != h
+        || p->burn_pool_fmt != vfmt) {
+        if (p->burn_pool) {
+            CVPixelBufferPoolRelease(p->burn_pool);
+            p->burn_pool = NULL;
+        }
+        CFDictionaryRef empty = CFDictionaryCreate(
+            NULL, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        int fmti = (int)vfmt;
+        CFNumberRef wn = CFNumberCreate(NULL, kCFNumberIntType, &w);
+        CFNumberRef hn = CFNumberCreate(NULL, kCFNumberIntType, &h);
+        CFNumberRef fn = CFNumberCreate(NULL, kCFNumberIntType, &fmti);
+        const void *keys[4] = {
+            kCVPixelBufferIOSurfacePropertiesKey,
+            kCVPixelBufferPixelFormatTypeKey,
+            kCVPixelBufferWidthKey,
+            kCVPixelBufferHeightKey,
+        };
+        const void *vals[4] = { empty, fn, wn, hn };
+        CFDictionaryRef attrs = CFDictionaryCreate(
+            NULL, keys, vals, 4,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn pr = CVPixelBufferPoolCreate(NULL, NULL, attrs, &p->burn_pool);
+        CFRelease(attrs);
+        CFRelease(empty);
+        CFRelease(wn);
+        CFRelease(hn);
+        CFRelease(fn);
+        if (pr != kCVReturnSuccess || !p->burn_pool) {
+            MP_ERR(vo, "burn-in output pool create failed: %d\n", (int)pr);
+            p->burn_pool = NULL;
+            return NULL;
+        }
+        p->burn_pool_w = w;
+        p->burn_pool_h = h;
+        p->burn_pool_fmt = vfmt;
+    }
+
+    CVPixelBufferRef out = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(NULL, p->burn_pool, &out) != kCVReturnSuccess
+        || !out)
+        return NULL;
+
+    // Carry the source colorimetry onto the composited buffer so the
+    // CMVideoFormatDescription built from it presents the same colors / EDR.
+    CVBufferPropagateAttachments(video, out);
+
+    ensure_ci_ctx(p);
+    if (!p->ci_ctx) {
+        CVPixelBufferRelease(out);
+        return NULL;
+    }
+
+    CGColorSpaceRef out_cs = burn_output_colorspace(mpi->params.color.transfer);
+    if (!out_cs) {
+        // Without a target colour space, CoreImage would encode extended-linear
+        // BT.2020 values into a PQ/HLG-tagged buffer -> wrong colours. Fall back
+        // to the plain frame rather than emit mis-tagged pixels.
+        CVPixelBufferRelease(out);
+        return NULL;
+    }
+    CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    @autoreleasepool {
+        CIImage *bg = [CIImage imageWithCVPixelBuffer:video];
+        // Tag the untagged BGRA OSD canvas as sRGB explicitly so CoreImage maps
+        // SDR white to reference white (not the PQ/HLG peak) — this is what
+        // keeps subtitles legible and unclipped over HDR video.
+        NSDictionary *fgOpts = srgb ? @{ (id)kCIImageColorSpace: (id)srgb } : @{};
+        CIImage *fg = [CIImage imageWithCVPixelBuffer:p->burn_osd_buf options:fgOpts];
+        if (bg && fg) {
+            CIImage *composited = [fg imageByCompositingOverImage:bg];
+            [p->ci_ctx render:composited
+              toCVPixelBuffer:out
+                       bounds:[bg extent]
+                   colorSpace:out_cs];
+        } else {
+            CVPixelBufferRelease(out);
+            out = NULL;
+        }
+    }
+    if (srgb)
+        CGColorSpaceRelease(srgb);
+    CGColorSpaceRelease(out_cs);
+    return out;
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    if (!p->layer || !frame->current)
+        return true;
+
+    struct mp_image *mpi = frame->current;
+
+    // Hardware frames carry the CVPixelBuffer in planes[3] (zero-copy);
+    // software frames are uploaded into a CVPixelBuffer we own and release.
+    CVPixelBufferRef pb;
+    bool owns_pb;
+    if (mpi->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+        pb = (CVPixelBufferRef)mpi->planes[3];
+        owns_pb = false;
+    } else {
+        pb = sw_image_to_pixel_buffer(vo, mpi);
+        owns_pb = true;
+    }
+    if (!pb)
+        return false;
+
+    // PiP burn-in (arnage #480): composite the OSD into the video frame so the
+    // single layer the OS shows in PiP carries subtitles. Off by default; when
+    // off this whole block is skipped and the VO behaves exactly as #481.
+    // burn_in_active reads a KVC flag → an autoreleased NSNumber; mpv's
+    // vo_thread wraps nothing, so drain it here (the rest of draw_frame uses
+    // only CoreFoundation create-rule objects).
+    bool burn_in;
+    @autoreleasepool { burn_in = burn_in_active(p); }
+    if (burn_in) {
+        CVPixelBufferRef burned = burn_composite(vo, mpi, pb);
+        if (burned) {
+            if (owns_pb)
+                CVPixelBufferRelease(pb);
+            pb = burned;
+            owns_pb = true;
+        }
+        // The separate OSD layer is not presented in PiP; flush it once so a
+        // stale cue does not linger behind the burned-in frames.
+        if (!p->burn_osd_flushed && p->osd_layer) {
+            AVSampleBufferDisplayLayer *ol = p->osd_layer;
+            p->burn_osd_flushed = true;
+            dispatch_async(dispatch_get_main_queue(), ^{
+                [ol flushAndRemoveImage];
+            });
+        }
+        // draw_osd_overlay is skipped while burning in, so the inline OSD
+        // layer's change id is frozen. Invalidate it so the overlay
+        // re-composites the current cue the moment burn-in turns back off
+        // (e.g. leaving PiP mid-cue) instead of early-returning on a stale id.
+        p->osd_change_id = 0;
+    } else {
+        p->burn_osd_flushed = false;
+    }
+
+    // (Re)build the format description when the pixel buffer's format changes.
+    // CMVideoFormatDescriptionCreateForImageBuffer copies the color
+    // attachments (transfer function, primaries, matrix) from the buffer, so
+    // HDR frames are presented with their real colorimetry -> OS-driven EDR.
+    if (!p->fmt || !CMVideoFormatDescriptionMatchesImageBuffer(p->fmt, pb)) {
+        if (p->fmt) {
+            CFRelease(p->fmt);
+            p->fmt = NULL;
+        }
+        OSStatus st = CMVideoFormatDescriptionCreateForImageBuffer(
+            kCFAllocatorDefault, pb, &p->fmt);
+        if (st != noErr || !p->fmt) {
+            MP_ERR(vo, "CMVideoFormatDescriptionCreateForImageBuffer failed: %d\n",
+                   (int)st);
+            if (owns_pb)
+                CVPixelBufferRelease(pb);
+            return false;
+        }
+    }
+
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+    CMSampleBufferRef sbuf = NULL;
+    OSStatus st = CMSampleBufferCreateReadyWithImageBuffer(
+        kCFAllocatorDefault, pb, p->fmt, &timing, &sbuf);
+    // The sample buffer now retains the image buffer (when it succeeds), so the
+    // software upload buffer can be released regardless of the outcome.
+    if (owns_pb)
+        CVPixelBufferRelease(pb);
+    if (st != noErr || !sbuf) {
+        MP_ERR(vo, "CMSampleBufferCreateReadyWithImageBuffer failed: %d\n",
+               (int)st);
+        return false;
+    }
+
+    // mpv's render loop already paces draw_frame/flip_page to the target time,
+    // so request immediate display on the layer's own queue.
+    CFArrayRef attachments =
+        CMSampleBufferGetSampleAttachmentsArray(sbuf, true);
+    if (attachments && CFArrayGetCount(attachments) > 0) {
+        CFMutableDictionaryRef dict =
+            (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+        CFDictionarySetValue(dict, kCMSampleAttachmentKey_DisplayImmediately,
+                             kCFBooleanTrue);
+    }
+
+    AVSampleBufferDisplayLayer *layer = p->layer;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (layer.status == AVQueuedSampleBufferRenderingStatusFailed)
+            [layer flush];
+        [layer enqueueSampleBuffer:sbuf];
+        CFRelease(sbuf);   // block owns the only reference
+    });
+
+    // Composite subtitles/OSD onto the inline OSD layer (no-op if disabled;
+    // skipped while burning in — the OSD is already in the video frame).
+    if (!burn_in)
+        draw_osd_overlay(vo, mpi);
+
+    return true;
+}
+
+static void flip_page(struct vo *vo)
+{
+    // Presentation is driven by enqueueSampleBuffer + DisplayImmediately;
+    // nothing to swap here.
+}
